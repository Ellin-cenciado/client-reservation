# Ignore Frontend Source Files inside the Spring/Java Static Folder
# ----------------------------------------------------------------------
web/src/main/resources/static/src/
web/src/main/resources/static/public/
web/src/main/resources/static/package*.json
web/src/main/resources/static/tsconfig*.json
web/src/main/resources/static/vite.config.ts
web/src/main/resources/static/eslint.config.js
web/src/main/resources/static/README.md